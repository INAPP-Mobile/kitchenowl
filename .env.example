# KitchenOwl on Railway — environment variables.
# Only JWT_SECRET_KEY is set on the deploy form (generated). Everything
# else is baked into the image; the list below documents what the
# deployment consumes, including applicable upstream variables.

# Required (generated on deploy — do not reuse the upstream default).
JWT_SECRET_KEY=your-generated-secret

# Baked into the image (defaults shown for reference).
STORAGE_PATH=/data
DB_DRIVER=sqlite
OPEN_REGISTRATION=false
EMAIL_MANDATORY=false
COLLECT_METRICS=false

# Optional upstream variables (unset by default; set only if you need them).
# FRONT_URL=https://your-domain.up.railway.app
# DISABLE_ONBOARDING=false
# SKIP_UPGRADE_DEFAULT_ITEMS=false
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
